# Токен вашего Telegram бота (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# URL вашего API сервера
API_URL=http://localhost:8000

# API ключ для доступа к вашему API
API_KEY=your_api_key_here

# ID чата для отправки уведомлений
CHAT_ID=your_chat_id_here

# ID пользователя, который может управлять ботом
AUTHORIZED_USER_ID=your_user_id_here

# Интервал проверки статуса в секундах
CHECK_INTERVAL=60
# ID компьютеров для мониторинга через запятую
COMPUTERS=main_pc
